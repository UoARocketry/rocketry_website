# Database connection strings
DATABASE_URL="postgresql://<db-user>:<db-password>@<db-host>:6543/postgres"
DIRECT_URL="postgresql://<db-user>:<db-password>@<db-host>:5432/postgres"

# App auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate-a-strong-random-secret>"

# Optional frontend storage base URL
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://<project-ref>.supabase.co/storage/v1/object/public"

# Payload media upload storage settings (Supabase S3-compatible)
SUPABASE_STORAGE_BUCKET="images"
SUPABASE_STORAGE_S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
SUPABASE_STORAGE_S3_REGION="ap-southeast-2"
SUPABASE_STORAGE_S3_ACCESS_KEY_ID="<supabase-s3-access-key-id>"
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY="<supabase-s3-secret-access-key>"
SUPABASE_STORAGE_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/images"

# Optional server-side Supabase access
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# Payload settings
PAYLOAD_SECRET="<generate-a-strong-random-secret>"
PAYLOAD_INITIAL_ADMIN_PASSWORD="<set-on-first-run>"
